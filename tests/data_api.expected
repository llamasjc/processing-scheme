def t1():
    t_l1 = create_table()
    add_column(t_l1, "name")
    add_column(t_l1, "age")
    r_l2 = add_row(t_l1)
    set_string(r_l2, "name", "ada")
    set_int(r_l2, "age", 36)
    return [get_row_count(t_l1), get_column_count(t_l1), get_string(t_l1, 0, "name"), get_int(t_l1, 0, "age")]

def t2():
    d_l3 = parse_json_object("{\"a\": 1, \"b\": [2, 3]}")
    return [has_key(d_l3, "a"), get_int(d_l3, "a"), get_int(get_json_array(d_l3, "b"), 1), keys(d_l3), get_int(d_l3, "zz", 7)]

def t3():
    return [concat([1, 2], [3]), subset([1, 2, 3, 4], 1, 2), sort_reverse([1, 3, 2]), len(shuffle([1, 2, 3]))]

def t4():
    x_l4 = parse_xml("<a><b k=\"1\">hi</b><b k=\"2\"/></a>")
    return [get_name(x_l4), get_child_count(x_l4), get_content(get_child(x_l4, 0)), get_int(get_child(x_l4, 1), "k"), has_attribute(get_child(x_l4, 0), "k"), len(get_children(x_l4, "b"))]

def t5():
    d_l5 = make_hash_table()
    increment(d_l5, "x")
    increment(d_l5, "x", 2)
    return get_int(d_l5, "x")

def c1():
    return [curve_point(0, 10, 20, 30, 0.5), curve_point(0, 10, 20, 30, 0), curve_point(0, 10, 20, 30, 1)]

def c2():
    return (curve_tightness(1), (lambda v: [curve_tightness(0), v][-1])(curve_point(0, 10, 20, 30, 0.5)))[-1]


_scm_wrap(globals())
run()
