def t1():
    return ["abc"[1], "hello"[1:3], "ab".upper(), string_to_symbol("x"), ord('A'), chr(66), string_index("abc", 'b')]

def t2():
    return [list(map(_add, [1, 2], [10, 20])), _max(*([3, 9, 2])), list(reversed([1, 2, 3])), ([1] + [2, 3] + []), len([1, 2]), list([1, 2])]

def t3():
    return [next((_p for _p in [["a", 1], ["b", 2]] if _p[0] == "b"), False), next((_p for _p in [[1, "x"], [2, "y"]] if _p[0] == 2), False), is_null([]), (isinstance([], list) and len([]) > 0), isinstance([1], list), boolean_eq__p(True, True)]

def t4():
    v = make_vector(3, 0)
    v.__setitem__(0, 9)
    vector_fill(v, 7)
    return [v[1], len(v), vector_to_list(v)]

def t5():
    acc = []
    def _lam1(a, b):
        nonlocal acc
        acc = cons((a + b), acc)
    for _fi in zip([1, 2], [10, 20]):
        _lam1(*_fi)
    return acc


