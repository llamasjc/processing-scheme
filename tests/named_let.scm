(define (draw)
  (let loop ((i 0))
    (when (< i 3)
      (ellipse i 0 1 1)
      (loop (+ i 1))))
  (fill 255)
  (rect 0 0 1 1))
(define (sum-to n)
  (let loop ((i 0) (acc 0))
    (if (> i n) acc (loop (+ i 1) (+ acc i)))))
(define (classify x)
  (if (> x 0)
      (if (> x 100)
          (let loop ((i x)) (if (< i 100) i (loop (- i 10))))
          'small)
      'neg))
